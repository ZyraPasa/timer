{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"target": "ESNext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"skipLibCheck": true,
		"strict": true,
		"outDir": "./dist",
		"rootDir": "src",
		// "baseUrl": ".",
		"types": ["node"]
	},
	"include": ["src/**/*"]
}
